PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/vrclass
# 綁定位址：預設 0.0.0.0（可從區網 IP 連入，供頭戴顯示器用）；只允許本機則設 127.0.0.1
# HOST=0.0.0.0
# 選填：若設定，VR POST 的 apikey 欄位必須與此相同（與 Unity 場景預設一致可設 elckvl3fds4s）
# VR_API_KEY=elckvl3fds4s
# 選填：設 1 時在終端機印出每次 VR 寫入（除錯用，歷程筆數多時勿常開）
# VR_LOG=1
# 選填：以 uid 彙整五個 VR collection 交給 OpenAI 分析（gptfeedback 內建頁）
OPENAI_API_KEY=
# 選填：OpenAI 模型，預設 gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini
# 選填：每 collection 帶入 Chat 的最多筆數、總字元上限
# GPT_VR_MAX_DOCS=200
# GPT_VR_MAX_CONTEXT_CHARS=80000

# 中文語系（Azure 語音辨識 / 文字情緒）
SPEECH_LOCALE=zh-TW

# Azure Speech（語音辨識，/api/vr-emotion/stt）
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia

# Azure AI Language（文字情緒，/api/vr-emotion/text-sentiment）
# ⚠️ 與 AZURE_SPEECH_KEY 是不同資源，需另外在 Portal 建立 Language 資源
AZURE_LANGUAGE_KEY=
AZURE_LANGUAGE_ENDPOINT=https://<your-language-resource>.cognitiveservices.azure.com
# AZURE_LANGUAGE_TIMEOUT_MS=15000

# openSMILE 聲音情緒（/api/vr-emotion/voice-emotion）
# 這是獨立的 Python (FastAPI) 服務，Node 只是用 HTTP 呼叫它，需另外常駐執行：
#   npm run emotion-install   （第一次，安裝 Python 套件）
#   npm run emotion-api       （啟動 FastAPI，預設 127.0.0.1:8000）
OPENSMILE_API_URL=http://127.0.0.1:8000
# OPENSMILE_HEALTH_TIMEOUT_MS=3000
# OPENSMILE_ANALYZE_TIMEOUT_MS=180000

# 本地語音辨識 faster-whisper（/api/stt/transcribe），取代語音對話原本每輪上傳到 OpenAI Whisper 雲端的做法
# 這也是獨立的 Python (FastAPI) 服務，Node 只是用 HTTP 呼叫它，需另外常駐執行：
#   npm run stt-install   （第一次，安裝 Python 套件）
#   npm run stt-api       （啟動 FastAPI，預設 127.0.0.1:8001）
LOCAL_STT_API_URL=http://127.0.0.1:8001
# LOCAL_STT_HEALTH_TIMEOUT_MS=3000
# LOCAL_STT_TRANSCRIBE_TIMEOUT_MS=30000
