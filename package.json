{
  "name": "vrclass-setting",
  "version": "1.0.0",
  "description": "AI × IVR 師資生情緒管理訓練系統 - 資料編輯與紀錄模組、使用者操作與資料反饋模組",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "vr:test-post": "node scripts/post-vr-test-rows.js",
    "emotion-install": "py -3.12 -m pip install -r python/emotion/requirements.txt",
    "emotion-api": "py -3.12 -m uvicorn emotion_api:app --host 127.0.0.1 --port 8000 --app-dir python/emotion"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "microsoft-cognitiveservices-speech-sdk": "^1.42.0",
    "mongoose": "^5.13.16",
    "multer": "^1.4.5-lts.1",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0"
  }
}
